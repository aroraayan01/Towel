# Copy to .env.local and fill in.

# Public URL of the site (used in emails, sitemap, Stripe redirects, social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite by default. Relative paths resolve from the project root.
DATABASE_URL=file:./prisma/dev.db

# ── Payments (Stripe) ────────────────────────────────────────────
# Leave blank to run in DEMO MODE: orders are created and marked paid without
# taking money. Afterpay, Apple Pay and Google Pay are switched on in the
# Stripe Dashboard (Settings → Payment methods) — no code change needed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (order confirmations, contact form) ────────────────────
# Leave SMTP_HOST blank and emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="xomexo <hello@xomexo.com>"
# Where contact-form messages and new-order alerts are sent
MAIL_ADMIN=hello@xomexo.com

# ── Admin (/admin) ───────────────────────────────────────────────
# Long random strings. ADMIN_SECRET signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SECRET=
