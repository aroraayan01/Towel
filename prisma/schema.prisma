// Wattle & Weave — data model
//
// Prisma 7: the `prisma-client` generator with an explicit `output` is
// required, and the datasource URL lives in prisma.config.ts.
//
// SQLite locally. To run on MySQL/MariaDB in production, change `provider`
// to "mysql", swap the adapter in lib/prisma.ts for @prisma/adapter-mariadb,
// delete prisma/migrations and run `npx prisma migrate dev --name init`.
//
// Money is always stored in whole cents (AUD, GST-inclusive) — never floats.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  /// "towels" | "rugs"
  category     String
  /// e.g. "bath-towels", "beach-towels", "hand-towels", "bath-mats", "runners", "area-rugs"
  collection   String
  tagline      String
  description  String
  /// JSON array of bullet-point strings
  details      String
  material     String
  care         String
  /// Drives the illustrated product art until real photos exist:
  /// towel: "stripe" | "plain" | "waffle" | "fouta"
  /// rug:   "stripe" | "diamond" | "border" | "check" | "plain"
  pattern      String
  /// Optional real photo URL — overrides the illustration when set
  imageUrl     String?
  featured     Boolean  @default(false)
  bestseller   Boolean  @default(false)
  isNew        Boolean  @default(false)
  monogramable Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants   Variant[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([category, collection])
}

model Variant {
  id          String  @id @default(cuid())
  productId   String
  sku         String  @unique
  colourName  String
  colourHex   String
  accentHex   String
  size        String
  priceCents  Int
  /// Shown struck-through when higher than priceCents
  compareAtCents Int?
  stock       Int     @default(0)
  sortOrder   Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  location  String?
  rating    Int
  title     String
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, approved])
}

model Order {
  id              String    @id @default(cuid())
  /// Human-facing order number, e.g. WW-10042
  number          String    @unique
  /// Secret used in the confirmation URL so order numbers can't be enumerated
  accessToken     String    @unique
  email           String
  firstName       String
  lastName        String
  phone           String?
  address1        String
  address2        String?
  suburb          String
  state           String
  postcode        String
  shippingMethod  String
  shippingCents   Int
  subtotalCents   Int
  discountCode    String?
  discountCents   Int       @default(0)
  giftWrapCents   Int       @default(0)
  totalCents      Int
  /// GST included in totalCents (1/11th of taxable supply)
  gstCents        Int
  giftMessage     String?
  marketingOptIn  Boolean   @default(false)
  /// PENDING | PAID | PACKED | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  status          String    @default("PENDING")
  trackingNumber  String?
  stripeSessionId String?   @unique
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items OrderItem[]

  @@index([email])
  @@index([status, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  name         String
  variantLabel String
  unitCents    Int
  quantity     Int
  monogram     String?
  monogramCents Int    @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model DiscountCode {
  code          String   @id
  percentOff    Int
  minSpendCents Int      @default(0)
  active        Boolean  @default(true)
  /// Single-use per email address
  oncePerEmail  Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orderRef  String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
