// xomexo: data model
//
// Prisma 7: the `prisma-client` generator with an explicit `output` is
// required, and the datasource URL lives in prisma.config.ts.
//
// SQLite locally. To run on MySQL/MariaDB in production, change `provider`
// to "mysql", swap the adapter in lib/prisma.ts for @prisma/adapter-mariadb,
// delete prisma/migrations and run `npx prisma migrate dev --name init`.
//
// Money is always stored in whole cents (AUD, GST-inclusive) — never floats.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  /// "bath" | "bedding" | "rugs" | "leather" (lib/collections.ts)
  category     String
  /// A collection slug within the category, e.g. "bath-towels", "quilts", "bags"
  collection   String
  tagline      String
  description  String
  /// JSON array of bullet-point strings
  details      String
  /// JSON array of { label, value } rows for the specifications table
  specs        String   @default("[]")
  material     String
  care         String
  featured     Boolean  @default(false)
  bestseller   Boolean  @default(false)
  isNew        Boolean  @default(false)
  monogramable Boolean  @default(false)
  active       Boolean  @default(true)
  /// True for the starter catalogue loaded by prisma/seed.ts. Products made or
  /// edited in /admin are false, and the seed never touches those.
  fromSeed     Boolean  @default(false)
  /// Null for xomexo's own products; otherwise the marketplace seller who sells and ships it
  sellerId       String?
  /// "pending" | "approved" | "rejected". Seller products are only shown once approved.
  reviewStatus   String    @default("approved")
  /// Why a seller's product or changes were turned down, shown to the seller
  reviewNote     String?
  /// A seller's edits to an approved product, waiting for approval (JSON of changed fields).
  /// The shop keeps showing the approved version until then.
  pendingChanges String?
  submittedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller     Seller?   @relation(fields: [sellerId], references: [id])
  variants   Variant[]
  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]

  @@index([category, collection])
  @@index([sellerId])
  @@index([reviewStatus])
}

/// Product photos. Images with a colourName only show when that colour is
/// selected; images without one (lifestyle shots) show for every colour.
model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  url        String
  alt        String
  colourName String?
  /// Photographer / source, kept so stock photo licences can be traced
  credit     String?
  sortOrder  Int     @default(0)
  /// Photos added by a seller stay hidden from the shop until approved
  approved   Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Variant {
  id          String  @id @default(cuid())
  productId   String
  sku         String  @unique
  colourName  String
  colourHex   String
  accentHex   String
  size        String
  priceCents  Int
  /// Shown struck-through when higher than priceCents
  compareAtCents Int?
  stock       Int     @default(0)
  sortOrder   Int     @default(0)
  /// Removed from sale but kept because past orders refer to it. Never shown in the shop.
  archived    Boolean @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  location  String?
  rating    Int
  title     String
  body      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, approved])
}

model Order {
  id              String    @id @default(cuid())
  /// Human-facing order number, e.g. 1042
  number          String    @unique
  /// Secret used in the confirmation URL so order numbers can't be enumerated
  accessToken     String    @unique
  email           String
  firstName       String
  lastName        String
  phone           String?
  address1        String
  address2        String?
  suburb          String
  state           String
  postcode        String
  shippingMethod  String
  shippingCents   Int
  subtotalCents   Int
  discountCode    String?
  discountCents   Int       @default(0)
  giftWrapCents   Int       @default(0)
  totalCents      Int
  /// GST included in totalCents (1/11th of taxable supply)
  gstCents        Int
  giftMessage     String?
  marketingOptIn  Boolean   @default(false)
  /// PENDING | PAID | PACKED | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  status          String    @default("PENDING")
  trackingNumber  String?
  stripeSessionId String?   @unique
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items     OrderItem[]
  shipments Shipment[]

  @@index([email])
  @@index([status, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  variantId    String
  name         String
  variantLabel String
  unitCents    Int
  quantity     Int
  monogram     String?
  monogramCents Int    @default(0)
  /// GST included in this line (0 when the supplier isn't registered for GST)
  gstCents     Int     @default(0)
  /// Copied from the product at the time of sale
  sellerId     String?
  shipmentId   String?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  variant Variant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model DiscountCode {
  code          String   @id
  percentOff    Int
  minSpendCents Int      @default(0)
  active        Boolean  @default(true)
  /// Single-use per email address
  oncePerEmail  Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  orderRef  String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// People who can log in to /admin. Roles are defined in lib/staff.ts.
model StaffUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  /// "owner" | "manager" | "fulfilment"
  role               String
  /// scrypt hash, see lib/passwords.ts
  passwordHash       String
  /// Set for new accounts and password resets: they choose their own on first login
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  /// Bumped on password change, reset or deactivation, which ends every session
  sessionVersion     Int       @default(1)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activity AuditLog[]
}

/// Who did what in /admin
model AuditLog {
  id        String   @id @default(cuid())
  staffId   String?
  /// Kept as text so the log still reads correctly if the account is removed
  staffName String
  /// e.g. "product.update", "order.status", "staff.create"
  action    String
  /// Human-readable subject, e.g. "Merino Wool Quilt" or "Order #1042"
  target    String
  /// Link to the thing in admin, when there is one
  href      String?
  detail    String?
  createdAt DateTime @default(now())

  staff StaffUser? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ── Marketplace ───────────────────────────────────────────────────────────────

/// A business that sells through the shop and ships its own orders.
model Seller {
  id              String    @id @default(cuid())
  /// Used in the public URL /makers/<slug>
  slug            String    @unique
  /// Shop name shown to customers
  name            String
  contactName     String
  email           String    @unique
  phone           String?
  abn             String?
  legalName       String?
  gstRegistered   Boolean   @default(false)
  website         String?
  instagram       String?
  /// Public "about" text on their maker page
  bio             String    @default("")
  /// What they told us when applying
  application     String    @default("")
  /// JSON array of categories they applied to sell in
  categories      String    @default("[]")
  shipFromSuburb  String?
  shipFromState   String?
  shipFromPostcode String?
  /// Business days between an order and dispatch, shown on their products
  dispatchDays    Int       @default(3)
  bankAccountName String?
  /// BSB and account number, encrypted with ADMIN_SECRET (lib/secretbox.ts)
  bankDetailsEnc  String?
  bankLast4       String?
  /// Commission in basis points: 1500 = 15%
  commissionBps   Int       @default(1500)
  /// "pending" (applied) | "active" | "suspended" | "rejected"
  status          String    @default("pending")
  /// Reason shown to the seller when rejected or suspended
  statusNote      String?
  /// Private notes for staff
  internalNotes   String?
  agreedTermsAt   DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users     SellerUser[]
  products  Product[]
  shipments Shipment[]
  ledger    LedgerEntry[]
  payouts   Payout[]

  @@index([status])
}

/// A login to the seller portal (/seller).
model SellerUser {
  id                 String    @id @default(cuid())
  sellerId           String
  email              String    @unique
  name               String
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  sessionVersion     Int       @default(1)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

/// The part of an order one sender ships: one per seller, plus one for
/// xomexo's own products (sellerId null).
model Shipment {
  id               String    @id @default(cuid())
  orderId          String
  sellerId         String?
  /// "PENDING" (awaiting payment) | "TO_SHIP" | "PACKED" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  status           String    @default("PENDING")
  merchandiseCents Int
  shippingCents    Int
  /// GST included in this shipment's delivery charge
  shippingGstCents Int       @default(0)
  method           String
  carrier          String?
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller Seller?     @relation(fields: [sellerId], references: [id])
  items  OrderItem[]
  ledger LedgerEntry[]

  @@index([orderId])
  @@index([sellerId, status])
}

/// What each seller is owed: sales in, commission and payouts out. The balance
/// is the sum of amountCents.
model LedgerEntry {
  id          String   @id @default(cuid())
  sellerId    String
  /// "SALE" | "COMMISSION" | "REFUND" | "COMMISSION_REFUND" | "PAYOUT" | "ADJUSTMENT"
  type        String
  /// Positive: owed to the seller. Negative: deducted.
  amountCents Int
  description String
  orderId     String?
  shipmentId  String?
  payoutId    String?
  /// When this can be paid out. Sales unlock a hold period after the seller ships.
  availableAt DateTime
  createdAt   DateTime @default(now())

  seller   Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  payout   Payout?   @relation(fields: [payoutId], references: [id])

  @@index([sellerId, availableAt])
}

/// A bank transfer to a seller, recorded by staff.
model Payout {
  id            String   @id @default(cuid())
  sellerId      String
  amountCents   Int
  /// Bank transfer reference
  reference     String?
  note          String?
  paidAt        DateTime
  createdByName String
  createdAt     DateTime @default(now())

  seller  Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@index([sellerId])
}
